{
    "folders": [
        {
            "path": "."
        }
    ],
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "🚀 Lancer l'UI (Sans Debug)",
                "type": "node-terminal",
                "request": "launch",
                "command": "cd ${workspaceFolder} && dotnet run --project src/RomPilot.UI/RomPilot.UI.csproj",
                "env": {
                    "DISPLAY": ":0",
                    "GDK_BACKEND": "x11"
                }
            },
            {
                "name": "🧪 Lancer les Tests",
                "type": "node-terminal",
                "request": "launch",
                "command": "cd ${workspaceFolder} && dotnet test src/RomPilot.Tests/RomPilot.Tests.csproj --logger 'console;verbosity=detailed'"
            },
            {
                "name": "🔍 Lancer l'UI avec Logs Détaillés",
                "type": "node-terminal",
                "request": "launch",
                "command": "cd ${workspaceFolder} && DOTNET_ENVIRONMENT=Development dotnet run --project src/RomPilot.UI/RomPilot.UI.csproj",
                "env": {
                    "DISPLAY": ":0",
                    "GDK_BACKEND": "x11",
                    "DOTNET_LOGGING__CONSOLE__DISABLECOLORS": "false"
                }
            }
        ]
    }
}