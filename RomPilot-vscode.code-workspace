{
    "folders": [
        {
            "path": "."
        }
    ],
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "🐛 Debug UI",
                "type": "coreclr",
                "request": "launch",
                "preLaunchTask": "build-ui",
                "program": "${workspaceFolder}/src/RomPilot.UI/bin/Debug/net8.0/RomPilot.UI.dll",
                "args": [],
                "cwd": "${workspaceFolder}/src/RomPilot.UI",
                "stopAtEntry": false,
                "console": "internalConsole",
                "env": {
                    "DISPLAY": ":0",
                    "GDK_BACKEND": "x11"
                }
            },
            {
                "name": "🧪 Debug Tests",
                "type": "coreclr",
                "request": "launch",
                "preLaunchTask": "build-tests",
                "program": "dotnet",
                "args": [
                    "test",
                    "${workspaceFolder}/src/RomPilot.Tests/RomPilot.Tests.csproj",
                    "--no-build",
                    "--logger",
                    "console;verbosity=detailed"
                ],
                "cwd": "${workspaceFolder}",
                "stopAtEntry": false,
                "console": "internalConsole"
            },
            {
                "name": "🧪 Debug Test (Current File)",
                "type": "coreclr",
                "request": "launch",
                "preLaunchTask": "build-tests",
                "program": "dotnet",
                "args": [
                    "test",
                    "${workspaceFolder}/src/RomPilot.Tests/RomPilot.Tests.csproj",
                    "--no-build",
                    "--filter",
                    "FullyQualifiedName~${fileBasenameNoExtension}"
                ],
                "cwd": "${workspaceFolder}",
                "stopAtEntry": false,
                "console": "internalConsole"
            }
        ]
    }
}