<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RomPilot.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="RomPilot.UI.Views.ScanResultsView"
             x:DataType="vm:ScanResultsViewModel">

    <Design.DataContext>
        <vm:ScanResultsViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" Margin="20">
        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Margin="0,0,0,15">
            <TextBlock.Text>
                <MultiBinding StringFormat="Found {0} ROM files">
                    <Binding Path="RomFiles.Count"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <!-- Results List -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding RomFiles}"
                  SelectedItem="{Binding SelectedRomFile}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*"/>
                <DataGridTextColumn Header="Console" Binding="{Binding Console.Name}" Width="150"/>
                <DataGridTextColumn Header="Size" Binding="{Binding FileSize, StringFormat='{}{0:N0} bytes'}" Width="120"/>
                <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="2*"/>
                <DataGridTextColumn Header="Archive" Binding="{Binding ArchivePath}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

