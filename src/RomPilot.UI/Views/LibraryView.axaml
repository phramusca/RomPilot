<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RomPilot.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="RomPilot.UI.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

    <Design.DataContext>
        <vm:LibraryViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*" Margin="20">
        <!-- Status Message -->
        <TextBlock Grid.Row="0" Text="{Binding StatusMessage}" FontSize="14" Margin="0,0,0,10"/>
        
        <!-- Header -->
        <TextBlock Grid.Row="1" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Margin="0,0,0,15">
            <TextBlock.Text>
                <MultiBinding StringFormat="Library: {0} ROM files">
                    <Binding Path="RomFiles.Count"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <!-- ROM Files List (takes ALL remaining height) -->
        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding RomFiles}"
                  SelectedItem="{Binding SelectedRomFile}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  VerticalAlignment="Stretch"
                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*"/>
                <DataGridTextColumn Header="Console" Binding="{Binding Console.Name}" Width="120"/>
                <DataGridTextColumn Header="Size" Binding="{Binding FileSize, StringFormat='{}{0:N0} bytes'}" Width="100"/>
                <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="2*"/>
                <DataGridTextColumn Header="Archive" Binding="{Binding ArchivePath}" Width="*"/>
                <DataGridTextColumn Header="Archive Depth" Binding="{Binding ArchiveDepth}" Width="80"/>
                <DataGridTextColumn Header="Detected At" Binding="{Binding DetectedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140"/>
                <DataGridTextColumn Header="Last Scanned" Binding="{Binding LastScannedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140"/>
                <DataGridTextColumn Header="Status" Binding="{Binding ProcessingStatus}" Width="80"/>
                <DataGridTextColumn Header="Checksums" Binding="{Binding Checksums.Count, StringFormat='{}{0} checksums'}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
