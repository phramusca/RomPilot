<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RomPilot.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="RomPilot.UI.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

    <Design.DataContext>
        <vm:LibraryViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,*,*" Margin="20">
        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Margin="0,0,0,15">
            <TextBlock.Text>
                <MultiBinding StringFormat="Found {0} ROM files">
                    <Binding Path="RomFiles.Count"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <!-- Processed Files List -->
        <StackPanel Grid.Row="1" Spacing="5" Margin="0,0,0,10" IsVisible="{Binding ProcessedFiles.Count}">
            <TextBlock Text="Processed Files:" FontWeight="Bold" FontSize="14"/>
            <ScrollViewer MaxHeight="150">
                <ItemsControl ItemsSource="{Binding ProcessedFiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#E8F5E9" Padding="5" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="{Binding FilePath}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#2E7D32"/>
                                    <TextBlock Text="{Binding Details}" FontSize="11" Foreground="#666" IsVisible="{Binding Details, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
        
        <!-- Failed Files List -->
        <StackPanel Grid.Row="2" Spacing="5" Margin="0,0,0,10" IsVisible="{Binding FailedFiles.Count}">
            <TextBlock Text="Failed Files:" FontWeight="Bold" FontSize="14" Foreground="#C62828"/>
            <ScrollViewer MaxHeight="150">
                <ItemsControl ItemsSource="{Binding FailedFiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFEBEE" Padding="5" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="{Binding FilePath}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding FailureReason}" FontSize="12" Foreground="#C62828"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!-- Results List -->
        <DataGrid Grid.Row="3" 
                  ItemsSource="{Binding RomFiles}"
                  SelectedItem="{Binding SelectedRomFile}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*"/>
                <DataGridTextColumn Header="Console" Binding="{Binding Console.Name}" Width="150"/>
                <DataGridTextColumn Header="Size" Binding="{Binding FileSize, StringFormat='{}{0:N0} bytes'}" Width="120"/>
                <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="2*"/>
                <DataGridTextColumn Header="Archive" Binding="{Binding ArchivePath}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

