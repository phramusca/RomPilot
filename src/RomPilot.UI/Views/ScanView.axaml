<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RomPilot.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="RomPilot.UI.Views.ScanView"
             x:DataType="vm:ScanViewModel">

    <Design.DataContext>
        <vm:ScanViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="20">
        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Scan Directories for ROMs" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Directory Selection -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,10">
            <TextBox Grid.Column="0" 
                     Text="{Binding SelectedDirectory}" 
                     Watermark="Enter directory path or click Select..."
                     IsReadOnly="{Binding IsScanning}"/>
            <Button Grid.Column="1" 
                    Content="Select Directory" 
                    Command="{Binding SelectDirectoryCommand}"
                    IsEnabled="{Binding !IsScanning}"/>
        </Grid>

        <!-- Scan Type Selection -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,10" IsEnabled="{Binding !IsScanning}">
            <TextBlock Text="Type de scan :" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <RadioButton Content="⚡ Rapide (incrémental)" IsChecked="{Binding IsQuickScan}" GroupName="ScanType" ToolTip.Tip="Détecte les changements via timestamp + taille, réutilise checksums existants"/>
            <RadioButton Content="🔍 Complet (recalcul total)" IsChecked="{Binding !IsQuickScan}" GroupName="ScanType" ToolTip.Tip="Recalcule tous les checksums, même pour fichiers inchangés"/>
        </StackPanel>

        <!-- Status Message -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" FontSize="14" Margin="0,5"/>

        <!-- Progress Bar (only visible during scan) -->
        <StackPanel Grid.Row="4" Spacing="10" IsVisible="{Binding IsScanning}" Margin="0,0,0,10">
            <ProgressBar Value="{Binding ProgressPercentage}" 
                        Minimum="0" 
                        Maximum="100" 
                        Height="25"/>
            <TextBlock>
                <TextBlock.Text>
                    <MultiBinding StringFormat="Processing: {0}/{1}">
                        <Binding Path="ProgressCurrent"/>
                        <Binding Path="ProgressTotal"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <ScrollViewer MaxHeight="150">
                <ItemsControl ItemsSource="{Binding ProgressMessages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="5,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!-- Compteurs détaillés (visible après scan) -->
        <Grid Grid.Row="5" ColumnDefinitions="Auto,Auto,Auto,Auto,*" Margin="0,10" IsVisible="{Binding HasResults}">
            <Border Grid.Column="0" Background="#E8F5E9" Padding="10" CornerRadius="4" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="✓ Identifiés" FontSize="12" Foreground="#2E7D32" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding IdentifiedCount}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#FFF3E0" Padding="10" CornerRadius="4" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="? Non identifiés" FontSize="12" Foreground="#F57C00" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding UnidentifiedCount}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#E0E0E0" Padding="10" CornerRadius="4" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="⊘ Exclus" FontSize="12" Foreground="#616161" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ExcludedCount}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#FFEBEE" Padding="10" CornerRadius="4" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="✗ Échecs" FontSize="12" Foreground="#C62828" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding FailedCount}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Results Section (visible after scan) -->
        <Grid Grid.Row="6" RowDefinitions="Auto,*" VerticalAlignment="Stretch">
            <!-- Header -->
            <TextBlock Grid.Row="0" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Margin="0,0,0,10"
                       Text="{Binding ScannedFilesCount, StringFormat='Found {0} files'}"/>
            
            <!-- Files List (SIMPLE ItemsControl for reliability) -->
            <Border Grid.Row="1" 
                    BorderBrush="Gray" 
                    BorderThickness="1" 
                    CornerRadius="4"
                    Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ScannedFiles}" Margin="10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" 
                                        BorderThickness="0,0,0,1" 
                                        Padding="10,8"
                                        Background="#FAFAFA">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding IdentificationStatus}" 
                                                   FontWeight="Bold"
                                                   Margin="0,0,15,0"
                                                   Width="100"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding FileName}" 
                                                       FontWeight="SemiBold" 
                                                       FontSize="14"/>
                                            <TextBlock Text="{Binding FilePath}" 
                                                       FontSize="11" 
                                                       Foreground="Gray"/>
                                            <TextBlock Text="{Binding ExclusionReason, StringFormat='Raison: {0}'}" 
                                                       FontSize="11" 
                                                       Foreground="Gray"
                                                       IsVisible="{Binding ExclusionReason, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding FileSize, StringFormat='{}{0:N0} bytes'}" 
                                                   FontSize="11" 
                                                   Foreground="Gray"
                                                   Margin="10,0"/>
                                        <TextBlock Grid.Column="3" 
                                                   Text="{Binding ArchivePath}" 
                                                   FontSize="11" 
                                                   Foreground="DarkBlue"
                                                   IsVisible="{Binding ArchivePath, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Start Scan" 
                    Command="{Binding StartScanCommand}"
                    IsEnabled="{Binding !IsScanning}"
                    Width="120"/>
            <Button Content="Cancel" 
                    Command="{Binding CancelScanCommand}"
                    IsEnabled="{Binding IsScanning}"
                    Width="120"/>
        </StackPanel>
    </Grid>
</UserControl>

