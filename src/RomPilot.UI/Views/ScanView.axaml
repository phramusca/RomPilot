<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RomPilot.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="RomPilot.UI.Views.ScanView"
             x:DataType="vm:ScanViewModel">

    <Design.DataContext>
        <vm:ScanViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="20">
        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Scan Directories for ROMs" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Directory Selection -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,10">
            <TextBox Grid.Column="0" 
                     Text="{Binding SelectedDirectory}" 
                     Watermark="Enter directory path or click Select..."
                     IsReadOnly="{Binding IsScanning}"/>
            <Button Grid.Column="1" 
                    Content="Select Directory" 
                    Command="{Binding SelectDirectoryCommand}"
                    IsEnabled="{Binding !IsScanning}"/>
        </Grid>

        <!-- Status Message -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" FontSize="14" Margin="0,5"/>

        <!-- Progress Bar -->
        <Grid Grid.Row="3" RowDefinitions="Auto,Auto,*,*" IsVisible="{Binding IsScanning}">
            <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,10">
                <ProgressBar Value="{Binding ProgressPercentage}" 
                            Minimum="0" 
                            Maximum="100" 
                            Height="25"/>
                <TextBlock>
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Processing: {0}/{1}">
                            <Binding Path="ProgressCurrent"/>
                            <Binding Path="ProgressTotal"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
            
            <!-- Processed Files List -->
            <StackPanel Grid.Row="1" Spacing="5" Margin="0,0,0,10">
                <TextBlock Text="Processed Files:" FontWeight="Bold" FontSize="14"/>
                <ScrollViewer MaxHeight="150">
                    <ItemsControl ItemsSource="{Binding ProcessedFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#E8F5E9" Padding="5" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FilePath}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#2E7D32"/>
                                        <TextBlock Text="{Binding Details}" FontSize="11" Foreground="#666" IsVisible="{Binding Details, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
            
            <!-- Failed Files List -->
            <StackPanel Grid.Row="2" Spacing="5">
                <TextBlock Text="Failed Files:" FontWeight="Bold" FontSize="14" Foreground="#C62828"/>
                <ScrollViewer MaxHeight="150">
                    <ItemsControl ItemsSource="{Binding FailedFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFEBEE" Padding="5" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FilePath}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding FailureReason}" FontSize="12" Foreground="#C62828"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Start Scan" 
                    Command="{Binding StartScanCommand}"
                    IsEnabled="{Binding !IsScanning}"
                    Width="120"/>
            <Button Content="Cancel" 
                    Command="{Binding CancelScanCommand}"
                    IsEnabled="{Binding IsScanning}"
                    Width="120"/>
        </StackPanel>
    </Grid>
</UserControl>

