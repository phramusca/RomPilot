<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RomPilot.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="RomPilot.UI.Views.ScanView"
             x:DataType="vm:ScanViewModel">

    <Design.DataContext>
        <vm:ScanViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="20">
        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Scan Directories for ROMs" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Directory Selection -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,10">
            <TextBox Grid.Column="0" 
                     Text="{Binding SelectedDirectory}" 
                     Watermark="Enter directory path or click Select..."
                     IsReadOnly="{Binding IsScanning}"/>
            <Button Grid.Column="1" 
                    Content="Select Directory" 
                    Command="{Binding SelectDirectoryCommand}"
                    IsEnabled="{Binding !IsScanning}"/>
        </Grid>

        <!-- Status Message -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" FontSize="14" Margin="0,5"/>

        <!-- Progress Bar (only visible during scan) -->
        <StackPanel Grid.Row="3" Spacing="10" IsVisible="{Binding IsScanning}" Margin="0,0,0,10">
            <ProgressBar Value="{Binding ProgressPercentage}" 
                        Minimum="0" 
                        Maximum="100" 
                        Height="25"/>
            <TextBlock>
                <TextBlock.Text>
                    <MultiBinding StringFormat="Processing: {0}/{1}">
                        <Binding Path="ProgressCurrent"/>
                        <Binding Path="ProgressTotal"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <ScrollViewer MaxHeight="150">
                <ItemsControl ItemsSource="{Binding ProgressMessages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="5,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!-- Results Section (visible after scan) -->
        <Grid Grid.Row="4" RowDefinitions="Auto,Auto,Auto,*" IsVisible="{Binding HasResults}" VerticalAlignment="Stretch">
            <!-- Header -->
            <TextBlock Grid.Row="0" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Margin="0,0,0,10">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Found {0} ROM files">
                        <Binding Path="RomFiles.Count"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            
            <!-- Processed Files List (only visible if there are processed files) -->
            <Grid Grid.Row="1" 
                  RowDefinitions="Auto,*"
                  Margin="0,0,0,10"
                  IsVisible="{Binding ProcessedFiles.Count}">
                <TextBlock Grid.Row="0" Text="Processed Files:" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                <ScrollViewer Grid.Row="1" 
                              MaxHeight="200" 
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ProcessedFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#E8F5E9" Padding="5" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FilePath}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#2E7D32"/>
                                        <TextBlock Text="{Binding Details}" FontSize="11" Foreground="#666" IsVisible="{Binding Details, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            
            <!-- Failed Files List (only visible if there are failed files) -->
            <Grid Grid.Row="2" 
                  RowDefinitions="Auto,*"
                  Margin="0,0,0,10"
                  IsVisible="{Binding FailedFiles.Count}">
                <TextBlock Grid.Row="0" Text="Failed Files:" FontWeight="Bold" FontSize="14" Foreground="#C62828" Margin="0,0,0,5"/>
                <ScrollViewer Grid.Row="1" 
                              MaxHeight="200" 
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FailedFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFEBEE" Padding="5" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FilePath}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding FailureReason}" FontSize="12" Foreground="#C62828" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ROM Files List (takes ALL remaining height) -->
            <DataGrid Grid.Row="3" 
                      ItemsSource="{Binding RomFiles}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="All"
                      VerticalAlignment="Stretch">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*"/>
                    <DataGridTextColumn Header="Console" Binding="{Binding Console.Name}" Width="150"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding FileSize, StringFormat='{}{0:N0} bytes'}" Width="120"/>
                    <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="2*"/>
                    <DataGridTextColumn Header="Archive" Binding="{Binding ArchivePath}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Start Scan" 
                    Command="{Binding StartScanCommand}"
                    IsEnabled="{Binding !IsScanning}"
                    Width="120"/>
            <Button Content="Cancel" 
                    Command="{Binding CancelScanCommand}"
                    IsEnabled="{Binding IsScanning}"
                    Width="120"/>
        </StackPanel>
    </Grid>
</UserControl>

