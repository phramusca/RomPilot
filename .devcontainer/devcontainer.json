{
	"name": "RomPilot",
	"dockerComposeFile": "docker-compose.yml",
	"service": "devcontainer",
	"workspaceFolder": "/workspace",
	"postCreateCommand": "dotnet restore && dotnet build",
	"remoteUser": "vscode",
	"mounts": [
		"source=${localEnv:HOME},target=/host/home,type=bind,consistency=cached,readonly",
		"source=/media/${localEnv:USER},target=/host/media,type=bind,consistency=cached,readonly"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"anysphere.csharp",
				"josefpihrt-vscode.roslynator",
				"aaron-bond.better-comments",
				"ms-azuretools.vscode-docker"
			],
			"settings": {
				// ⚙️ Configuration .NET : Force l'utilisation du .NET 8.0 du container
				// Sans ces paramètres, certaines extensions (notamment les dépendances de Roslynator)
				// téléchargent automatiquement .NET 9.0 (~150 MB) alors qu'on utilise .NET 8.0.
				// Ces 4 paramètres bloquent l'acquisition automatique et forcent /usr/bin/dotnet.
				"dotnetAcquisitionExtension.sharedExistingDotnetPath": "/usr/bin/dotnet",
				"dotnetAcquisitionExtension.existingDotnetPath": "/usr/bin/dotnet",
				"dotnetAcquisitionExtension.enableTelemetry": false,
				"dotnet.dotnetPath": "/usr/bin/dotnet",
				// Editor
				"editor.formatOnSave": true,
				"editor.codeActionsOnSave": {
					"source.fixAll": "explicit",
					"source.organizeImports": "explicit"
				},
				// Files
				"files.exclude": {
					"**/bin": true,
					"**/obj": true,
					"**/.vs": true
				},
				"search.exclude": {
					"**/bin": true,
					"**/obj": true,
					"**/node_modules": true
				},
				"files.watcherExclude": {
					"**/bin/**": true,
					"**/obj/**": true
				},
				// C# Formatting
				"[csharp]": {
					"editor.defaultFormatter": "anysphere.csharp",
					"editor.rulers": [
						120
					],
					"editor.tabSize": 4,
					"editor.insertSpaces": true
				},
				// XML (pour les .csproj et .axaml)
				"[xml]": {
					"editor.tabSize": 2
				},
				// Terminal
				"terminal.integrated.defaultProfile.linux": "bash",
				// Problems
				"problems.showCurrentInStatus": true
			}
		}
	}
}