{
	"name": "RomPilot Development",
	"dockerComposeFile": "docker-compose.yml",
	"service": "devcontainer",
	"workspaceFolder": "/workspace",
	"postCreateCommand": "dotnet restore && dotnet build",
	"remoteUser": "vscode",
	"mounts": [
		"source=${localEnv:HOME},target=/host/home,type=bind,consistency=cached,readonly",
		"source=/media/${localEnv:USER},target=/host/media,type=bind,consistency=cached,readonly"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"josefpihrt-vscode.roslynator",
				"ms-dotnettools.vscode-dotnet-runtime",
				"aaron-bond.better-comments",
				"ms-azuretools.vscode-docker"
			],
			"settings": {
				// C# Language Server
				"omnisharp.enableRoslynAnalyzers": true,
				"omnisharp.enableEditorConfigSupport": true,
				// Solution
				"dotnet.defaultSolution": "RomPilot.sln",
				"dotnet.completion.showCompletionItemsFromUnimportedNamespaces": true,
				"dotnet.formatting.organizeImportsOnFormat": true,
				// Files
				"files.exclude": {
					"**/bin": true,
					"**/obj": true,
					"**/.vs": true
				},
				// Editor
				"editor.formatOnSave": true,
				"editor.codeActionsOnSave": {
					"source.fixAll": "explicit",
					"source.organizeImports": "explicit"
				},
				// C# Formatting
				"[csharp]": {
					"editor.defaultFormatter": "muhammad-sammy.csharp",
					"editor.formatOnSave": true,
					"editor.tabSize": 4,
					"editor.insertSpaces": true
				},
				// XML (pour les .csproj et .axaml)
				"[xml]": {
					"editor.tabSize": 2
				},
				// Terminal
				"terminal.integrated.defaultProfile.linux": "bash",
				// Problems
				"problems.showCurrentInStatus": true
			}
		}
	}
}