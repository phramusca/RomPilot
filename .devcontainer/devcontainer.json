{
	"name": "RomPilot Development",
	"dockerComposeFile": "docker-compose.yml",
	"service": "devcontainer",
	"workspaceFolder": "/workspace",
	"postCreateCommand": "dotnet restore && dotnet build",
	"remoteUser": "vscode",
	"mounts": [
		"source=${localEnv:HOME},target=/host/home,type=bind,consistency=cached,readonly",
		"source=/media/${localEnv:USER},target=/host/media,type=bind,consistency=cached,readonly"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				// Extension C# pour Cursor - fournit IntelliSense et autocomplétion
				// Note : ne supporte pas le debugging avec breakpoints (utiliser VS Code pour ça)
				"anysphere.csharp",
				"ms-dotnettools.vscode-dotnet-runtime",
				"aaron-bond.better-comments",
				"ms-azuretools.vscode-docker"
			],
			"settings": {
				"dotnet.defaultSolution": "RomPilot.sln",
				"omnisharp.enableRoslynAnalyzers": true,
				"omnisharp.enableEditorConfigSupport": true,
				"files.exclude": {
					"**/bin": true,
					"**/obj": true
				},
				// Configuration pour améliorer la performance
				"editor.formatOnSave": true,
				"editor.codeActionsOnSave": {
					"source.fixAll": "explicit"
				}
			}
		}
	}
}