{
    "name": "RomPilot - VS Code (Debug)",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "devcontainer",
    "workspaceFolder": "/workspace",
    "postCreateCommand": "dotnet restore && dotnet build && curl -sSL https://aka.ms/getvsdbgsh | bash /dev/stdin -v latest -l ~/.vsdbg",
    "remoteUser": "vscode",
    "mounts": [
        "source=${localEnv:HOME},target=/host/home,type=bind,consistency=cached,readonly",
        "source=/media/${localEnv:USER},target=/host/media,type=bind,consistency=cached,readonly"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csdevkit",
                "ms-dotnettools.csharp",
                "ms-dotnettools.vscode-dotnet-runtime",
                "josefpihrt-vscode.roslynator",
                "aaron-bond.better-comments",
                "ms-azuretools.vscode-docker"
            ],
            "settings": {}
        }
    },
    // Ouvrir directement le workspace file pour VS Code
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "onCreateCommand": "echo '✅ Dev Container VS Code prêt pour le debug !'"
}